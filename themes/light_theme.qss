QWidget {
    background-color: #f8f9fa;
    color: #1a1a1a;
    border: 0px;
    font-family: "Segoe UI", "Inter", "Roboto", Arial, sans-serif;
    font-size: 15px;
}
QMainWindow {
    background-color: #f8f9fa;
}
QMenuBar {
    background-color: #ffffff;
    color: #1a1a1a;
    border-bottom: 1px solid #d1d5db;
}
QMenuBar::item {
    padding: 6px 12px;
    background: transparent;
}
QMenuBar::item:selected {
    background-color: #2563eb;
    color: #ffffff;
    border-radius: 4px;
}
QMenu {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1px solid #d1d5db;
    padding: 4px;
}
QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #2563eb;
    color: #ffffff;
}
QPushButton {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1px solid #9ca3af;
    padding: 8px 16px;
    border-radius: 6px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #f3f4f6;
    border: 1px solid #6b7280;
}
QPushButton:pressed {
    background-color: #2563eb;
    color: #ffffff;
    border: 1px solid #2563eb;
}
QPushButton:disabled {
    background-color: #f3f4f6;
    color: #9ca3af;
    border: 1px solid #e5e7eb;
}
QLineEdit {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1px solid #9ca3af;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}
QLineEdit:focus {
    border: 1px solid #2563eb;
}
QSpinBox {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1px solid #9ca3af;
    border-radius: 6px;
    padding: 5px 8px;
}
QSpinBox:focus {
    border: 1px solid #2563eb;
}
QSpinBox::up-button, QSpinBox::down-button {
    background-color: #f9fafb;
    border: none;
    width: 18px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #f3f4f6;
}
QComboBox {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1px solid #9ca3af;
    padding: 6px 12px;
    border-radius: 6px;
}
QComboBox:hover {
    border: 1px solid #6b7280;
}
QComboBox::drop-down {
    border: 0px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1px solid #9ca3af;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
    outline: none;
}
QPlainTextEdit {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1px solid #9ca3af;
    border-radius: 6px;
    padding: 8px;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}
QPlainTextEdit:focus {
    border: 1px solid #2563eb;
}
QCheckBox {
    spacing: 12px;
    font-weight: bold;
}
QCheckBox::indicator {
    width: 20px;
    height: 20px;
}
QLabel {
    color: #1a1a1a;
    font-weight: bold;
}
QToolTip {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1px solid #9ca3af;
    padding: 4px;
}
QMessageBox {
    background-color: #f8f9fa;
}
QProgressBar {
    background-color: #ffffff;
    border: 1px solid #9ca3af;
    border-radius: 4px;
    text-align: center;
}
QProgressBar::chunk {
    background-color: #2563eb;
    border-radius: 3px;
}
